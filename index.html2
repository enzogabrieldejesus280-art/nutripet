<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nutripet | Nutrição natural, vida saudável</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

:root{
--green:#557b43;
--dark:#29452a;
--pink:#d96d83;
--cream:#faf7ef;
--white:#fffdf8;
--muted:#73776d;
--border:#e5dfd0
}

body{
font-family:Arial,Helvetica,sans-serif;
background:var(--cream);
color:var(--dark)
}

header{
background:var(--white);
border-bottom:1px solid var(--border);
padding:12px 20px
}

.header{
max-width:1100px;
margin:auto;
display:flex;
align-items:center;
justify-content:space-between
}

.logo{
width:260px;
height:105px;
object-fit:contain
}

.header-info{
display:flex;
gap:25px;
font-size:13px;
font-weight:bold
}

.header-info span:first-child{color:var(--green)}
.header-info span:last-child{color:var(--pink)}

nav{
background:var(--green);
position:sticky;
top:0;
z-index:10
}

.nav{
max-width:1100px;
margin:auto;
padding:9px 20px;
display:flex;
gap:5px;
overflow:auto
}

.tab{
border:0;
background:none;
color:#fff;
padding:11px 15px;
border-radius:9px;
font-weight:bold;
cursor:pointer;
white-space:nowrap
}

.tab:hover,.tab.active{
background:#fff;
color:var(--green)
}

main{
max-width:1100px;
margin:auto;
padding:32px 20px 50px
}

.aba{display:none}
.aba.active{display:block}

.title{
margin-bottom:22px
}

.title h2{
font-family:Georgia,serif;
font-size:27px;
color:var(--dark);
margin-bottom:6px
}

.title p{
color:var(--muted);
font-size:14px
}

.search{
display:grid;
grid-template-columns:1fr 180px;
gap:10px;
margin-bottom:15px
}

input,select{
width:100%;
padding:13px;
border:1px solid var(--border);
border-radius:10px;
background:#fff;
outline:none
}

input:focus,select:focus{
border-color:var(--green)
}

.info{
display:flex;
justify-content:space-between;
color:var(--muted);
font-size:12px;
margin-bottom:14px
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(225px,1fr));
gap:15px
}

.card,.box,.product{
background:var(--white);
border:1px solid var(--border);
border-radius:16px;
padding:19px
}

.card{
cursor:pointer
}

.card:hover{
box-shadow:0 7px 20px #304d2710
}

.top{
display:flex;
justify-content:space-between;
margin-bottom:14px
}

.icon{
width:42px;
height:42px;
border-radius:11px;
background:#edf3e8;
color:var(--green);
display:grid;
place-items:center;
font-weight:bold
}

.tag{
font-size:11px;
background:#f7e8eb;
color:#9b5362;
padding:5px 8px;
border-radius:7px;
height:max-content
}

.card h3,.product h3{
font-size:16px;
margin-bottom:7px
}

.card p,.box p,.product p{
font-size:13px;
color:var(--muted);
line-height:1.55
}

.weight{
display:block;
margin-top:13px;
font-size:13px;
font-weight:bold
}

.btn{
border:0;
background:var(--green);
color:#fff;
padding:11px 16px;
border-radius:9px;
font-weight:bold;
cursor:pointer
}

.btn:hover{
background:#456635
}

.secondary{
background:#fff;
color:#555;
border:1px solid var(--border)
}

.danger{
background:var(--pink)
}

.danger:hover{
background:#c55b71
}

.product-grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(220px,1fr));
gap:15px
}

.product-icon{
height:75px;
border-radius:11px;
background:#f1f4e9;
display:grid;
place-items:center;
color:var(--green);
font-weight:bold;
font-size:22px;
margin-bottom:13px
}

.price{
font-size:18px;
font-weight:bold;
margin:14px 0
}

.buy{
display:flex;
gap:7px
}

.buy input{
width:65px;
padding:10px
}

.cart{
margin-top:24px
}

.cart-item{
display:flex;
justify-content:space-between;
padding:12px 0;
border-bottom:1px solid var(--border);
font-size:13px
}

.total{
font-size:19px;
font-weight:bold;
text-align:right;
margin:18px 0
}

.loyalty{
max-width:570px;
margin:auto;
text-align:center
}

.loyalty-logo{
width:190px;
height:75px;
object-fit:contain
}

.points{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:9px;
max-width:500px;
margin:22px auto 13px
}

.point{
height:58px;
border:1px dashed #d8d0c1;
border-radius:12px;
display:grid;
place-items:center;
color:#777
}

.point.marked{
background:#f7dce2;
color:#b64f65;
border:2px solid var(--pink);
font-weight:bold
}

.reward{
display:none;
margin:17px auto 0;
background:#edf3e8;
color:#426238;
padding:13px;
border-radius:10px;
font-size:13px;
max-width:500px
}

.people{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
gap:12px;
margin-top:18px
}

.person{
background:#f1f3e9;
padding:17px;
border-radius:12px;
font-weight:bold
}

.overlay{
display:none;
position:fixed;
inset:0;
background:#0008;
z-index:100;
align-items:center;
justify-content:center;
padding:20px
}

.overlay.show{
display:flex
}

.modal{
background:#fffdf8;
max-width:570px;
width:100%;
max-height:90vh;
overflow:auto;
border-radius:18px;
padding:24px
}

.modal-head{
display:flex;
justify-content:space-between
}

.close{
border:0;
background:#eee;
width:33px;
height:33px;
border-radius:8px;
font-size:19px;
cursor:pointer
}

.details{
display:grid;
grid-template-columns:1fr 1fr;
gap:9px;
margin:19px 0
}

.detail{
background:#f2f3ec;
padding:13px;
border-radius:10px
}

.detail small{
display:block;
color:var(--muted);
margin-bottom:4px
}

.calc{
border-top:1px solid var(--border);
padding-top:17px
}

.calc p{
margin:7px 0 13px
}

.calc-row{
display:flex;
gap:8px
}

.result{
display:none;
background:#edf3e8;
color:#3d6136;
padding:13px;
border-radius:9px;
margin-top:11px;
font-size:13px
}

.warning{
margin-top:12px;
background:#fff5e2;
color:#755c28;
padding:11px;
border-radius:8px;
font-size:11px;
line-height:1.5
}

footer{
text-align:center;
padding:27px;
color:#777;
background:#eef1e4;
font-size:11px
}

.empty{
grid-column:1/-1;
text-align:center;
padding:40px;
background:var(--white);
border:1px solid var(--border);
border-radius:16px;
color:var(--muted)
}

@media(max-width:650px){

.header-info{
display:none
}

.logo{
width:220px
}

.search{
grid-template-columns:1fr
}

.grid,.product-grid{
grid-template-columns:repeat(2,1fr)
}

.details{
grid-template-columns:1fr
}

.calc-row{
flex-direction:column
}

}

@media(max-width:420px){

.grid,.product-grid{
grid-template-columns:1fr
}

}
</style>
</head>

<body>

<header>
<div class="header">

<img class="logo"
src="data:image/png;base64,"
alt="Nutripet">

<div class="header-info">
<span>100% Natural</span>
<span>Mais saúde para seu melhor amigo</span>
</div>

</div>
</header>


<nav>

<div class="nav">

<button class="tab active"
onclick="aba('racas',this)">
Raças
</button>

<button class="tab"
onclick="aba('compras',this)">
Compras
</button>

<button class="tab"
onclick="aba('fidelidade',this)">
Cartão Fidelidade
</button>

<button class="tab"
onclick="aba('cuidados',this)">
Cuidados
</button>

<button class="tab"
onclick="aba('sobre',this)">
Sobre o projeto
</button>

<button class="tab"
onclick="aba('criadores',this)">
Criadores
</button>

</div>

</nav>


<main>


<!-- RAÇAS -->

<section id="racas" class="aba active">

<div class="title">

<h2>
Encontre a raça do seu cão
</h2>

<p>
Pesquise uma raça e veja informações sobre peso, porte e petiscos.
</p>

</div>


<div class="search">

<input
id="pesquisa"
placeholder="Pesquisar raça..."
oninput="filtrar()"
>

<select
id="porte"
onchange="filtrar()"
>

<option value="todos">
Todos os portes
</option>

<option>
Pequeno
</option>

<option>
Pequeno/Médio
</option>

<option>
Médio
</option>

<option>
Médio/Grande
</option>

<option>
Grande
</option>

<option>
Gigante
</option>

</select>

</div>


<div class="info">

<span id="contador"></span>

<span>
Clique em uma raça para ver detalhes
</span>

</div>


<div id="lista" class="grid"></div>

</section>



<!-- COMPRAS -->

<section id="compras" class="aba">

<div class="title">

<h2>
Petiscos
</h2>

<p>
Escolha produtos para seu bichinho e adicione ao carrinho.
</p>

</div>


<div
id="produtos"
class="product-grid">
</div>


<div class="box cart">

<h2>
Seu carrinho
</h2>

<div id="carrinho"></div>

<div class="total">
Total: R$
<span id="total">
0,00
</span>
</div>

<button
class="btn"
onclick="finalizarCompra()">
Finalizar compra
</button>

<button
class="btn secondary"
onclick="limparCarrinho()">
Limpar
</button>

</div>

</section>



<!-- FIDELIDADE -->

<section id="fidelidade" class="aba">

<div class="title">

<h2>
Cartão Fidelidade
</h2>

<p>
A cada compra finalizada, você ganha um ponto.
</p>

</div>


<div class="box loyalty">

<img
src="data:image/png;base64,"
class="loyalty-logo"
alt="Nutripet"
>

<h2>
Seu cartão
</h2>


<div
id="pontos"
class="points">
</div>


<strong>

<span id="nPontos">
0
</span>

/10 compras

</strong>


<div style="margin-top:20px">

<button
class="btn danger"
onclick="resetPontos()">

Resetar cartão

</button>

</div>


<div
id="premio"
class="reward">

Cartão completo.
Você ganhou uma recompensa!

</div>

</div>

</section>



<!-- CUIDADOS -->

<section id="cuidados" class="aba">

<div class="title">

<h2>
Cuidados
</h2>

<p>
Informações para ajudar no dia a dia do seu bichinho.
</p>

</div>


<div class="grid">


<div class="box">

<h3>
Petiscos
</h3>

<p>
Ofereça petiscos com moderação e considere suas calorias na alimentação diária.
</p>

</div>


<div class="box">

<h3>
Hidratação
</h3>

<p>
Mantenha água limpa e fresca disponível durante todo o dia.
</p>

</div>


<div class="box">

<h3>
Atividade
</h3>

<p>
Passeios e brincadeiras ajudam na saúde física e mental do cachorro.
</p>

</div>


<div class="box">

<h3>
Alimentação
</h3>

<p>
A alimentação deve considerar idade, tamanho, atividade e necessidades individuais.
</p>

</div>


<div class="box">

<h3>
Peso
</h3>

<p>
O peso ideal pode variar entre cães da mesma raça.
</p>

</div>


<div class="box">

<h3>
Veterinário
</h3>

<p>
Consultas ajudam a acompanhar saúde, vacinação, alimentação e desenvolvimento.
</p>

</div>


</div>

</section>



<!-- SOBRE -->

<section id="sobre" class="aba">

<div class="title">

<h2>
Sobre o projeto
</h2>

<p>
Conheça a ideia por trás da Nutripet.
</p>

</div>


<div class="box">

<h2>
Nosso projeto
</h2>

<p>
A Nutripet é um projeto escolar criado com a ideia de representar uma empresa funcional voltada para o cuidado com os animais.
</p>

<p style="margin-top:12px">

A proposta é criar uma plataforma simples e fácil de usar, ajudando as pessoas a conhecer melhor seus bichinhos e encontrar informações sobre raças, peso, alimentação, petiscos e cuidados importantes.

</p>

<p style="margin-top:12px">

O projeto também mostra como a tecnologia pode facilitar o dia a dia dos tutores e tornar o cuidado com os animais mais simples e acessível.

</p>

<h3 style="margin-top:20px">
Importante
</h3>

<p>

As informações nutricionais são estimativas educacionais e não substituem a orientação de um médico-veterinário.

</p>

</div>

</section>



<!-- CRIADORES -->

<section id="criadores" class="aba">

<div class="title">

<h2>
Criadores
</h2>

<p>
Pessoas envolvidas no desenvolvimento da Nutripet.
</p>

</div>


<div class="box">

<h2>
Pessoas envolvidas
</h2>

<p>

O projeto foi desenvolvido em equipe, reunindo ideias de tecnologia, organização e criatividade para criar uma empresa que poderia funcionar de verdade.

</p>


<div
id="criadoresLista"
class="people">
</div>


<p
style="margin-top:24px;text-align:center">

<strong>
Feito com tecnologia, criatividade e carinho pelos nossos bichinhos.
</strong>

</p>

</div>

</section>

</main>


<footer>

Nutripet © 2026 — Nutrição natural, vida saudável

</footer>



<!-- MODAL DA RAÇA -->

<div
id="modal"
class="overlay"
onclick="fechar(event)">

<div class="modal">


<div class="modal-head">

<div>

<h2 id="mNome"></h2>

<p
id="mDesc"
style="color:#73776d;font-size:13px;margin-top:5px">
</p>

</div>


<button
class="close"
onclick="fechar()">
×
</button>

</div>


<div class="details">


<div class="detail">

<small>
Peso aproximado
</small>

<strong id="mPeso"></strong>

</div>


<div class="detail">

<small>
Porte
</small>

<strong id="mPorte"></strong>

</div>


<div class="detail">

<small>
Calorias extras
</small>

<strong id="mCal"></strong>

</div>


<div class="detail">

<small>
Petiscos pequenos
</small>

<strong id="mPet"></strong>

</div>


</div>


<div class="calc">

<h3>
Calcular pelo peso real
</h3>

<p>
Digite o peso atual do cachorro para obter uma estimativa.
</p>


<div class="calc-row">

<input
type="number"
id="peso"
min=".1"
step=".1"
placeholder="Peso em kg"
>

<button
class="btn"
onclick="calcular()">

Calcular

</button>

</div>


<div
id="resultado"
class="result">
</div>


<div class="warning">

Esta é apenas uma estimativa educacional.
A quantidade adequada depende das necessidades do animal e das calorias do petisco.
Para orientação individual, consulte um veterinário.

</div>

</div>

</div>

</div>



<script>


/* =========================
   RAÇAS
========================= */

const racas=[

["Chihuahua",1.5,3,"1,5–3 kg","Pequeno","15–20 kcal","1–2"],

["Yorkshire Terrier",2,3.2,"2–3,2 kg","Pequeno","20–25 kcal","2"],

["Lulu da Pomerânia",1.8,3.5,"1,8–3,5 kg","Pequeno","15–25 kcal","1–2"],

["Pinscher Miniatura",3.5,5,"3,5–5 kg","Pequeno","30–40 kcal","3–4"],

["Maltês",2,4,"2–4 kg","Pequeno","20–30 kcal","2–3"],

["Shih-tzu",4,7.5,"4–7,5 kg","Pequeno","30–50 kcal","3–5"],

["Pug",6,8,"6–8 kg","Pequeno","40–50 kcal","4–5"],

["Dachshund",3,5,"3–5 kg","Pequeno","30–40 kcal","3–4"],

["Lhasa Apso",5,8,"5–8 kg","Pequeno","30–50 kcal","3–5"],

["Pequinês",3,6,"3–6 kg","Pequeno","25–40 kcal","2–4"],

["Papillon",3,5,"3–5 kg","Pequeno","30–40 kcal","3–4"],

["Poodle Toy",2,4,"2–4 kg","Pequeno","20–30 kcal","2–3"],

["Poodle Miniatura",4,7,"4–7 kg","Pequeno","30–50 kcal","3–5"],

["Jack Russell Terrier",6,8,"6–8 kg","Pequeno","40–50 kcal","4–5"],

["Boston Terrier",6,11,"6–11 kg","Pequeno","40–60 kcal","4–6"],

["Bulldog Francês",8,14,"8–14 kg","Pequeno/Médio","50–75 kcal","5–7"],

["Cavalier King Charles Spaniel",5.5,8,"5,5–8 kg","Pequeno","40–50 kcal","4–5"],

["Cocker Spaniel Inglês",12,15,"12–15 kg","Médio","55–70 kcal","5–7"],

["Schnauzer Miniatura",5,9,"5–9 kg","Pequeno","30–55 kcal","3–5"],

["West Highland White Terrier",6,9,"6–9 kg","Pequeno","40–55 kcal","4–5"],

["Bichon Frisé",5,8,"5–8 kg","Pequeno","30–50 kcal","3–5"],

["Coton de Tuléar",4,6,"4–6 kg","Pequeno","30–40 kcal","3–4"],

["Havanês",3,6,"3–6 kg","Pequeno","25–40 kcal","2–4"],

["Griffon de Bruxelas",3.5,6,"3,5–6 kg","Pequeno","30–40 kcal","3–4"],

["Beagle",9,14,"9–14 kg","Médio","50–75 kcal","5–7"],

["Border Collie",14,23,"14–23 kg","Médio","60–90 kcal","6–9"],

["Golden Retriever",25,34,"25–34 kg","Grande","80–100 kcal","8–10"],

["Labrador Retriever",25,36,"25–36 kg","Grande","80–100 kcal","8–10"],

["Pastor Alemão",22,40,"22–40 kg","Grande","80–100 kcal","8–10"],

["Rottweiler",35,60,"35–60 kg","Grande","90–120 kcal","9–12"],

["Husky Siberiano",16,27,"16–27 kg","Médio/Grande","65–90 kcal","6–9"],

["Akita Inu",25,45,"25–45 kg","Grande","80–110 kcal","8–11"],

["Shiba Inu",8,11,"8–11 kg","Pequeno/Médio","45–60 kcal","4–6"],

["Doberman",27,45,"27–45 kg","Grande","80–110 kcal","8–11"],

["Boxer",25,32,"25–32 kg","Grande","80–100 kcal","8–10"],

["Dálmata",20,32,"20–32 kg","Grande","70–100 kcal","7–10"],

["Dogue Alemão",45,90,"45–90 kg","Gigante","100–140 kcal","10–14"],

["São Bernardo",55,90,"55–90 kg","Gigante","100–140 kcal","10–14"],

["Bernese Mountain Dog",35,55,"35–55 kg","Grande","90–120 kcal","9–12"],

["Chow Chow",20,32,"20–32 kg","Médio/Grande","70–100 kcal","7–10"],

["Shar Pei",18,30,"18–30 kg","Médio","65–90 kcal","6–9"],

["Cane Corso",40,50,"40–50 kg","Grande","90–120 kcal","9–12"],

["American Staffordshire Terrier",18,32,"18–32 kg","Médio","65–100 kcal","6–10"],

["Staffordshire Bull Terrier",11,17,"11–17 kg","Médio","55–80 kcal","5–8"],

["Bull Terrier",20,35,"20–35 kg","Médio/Grande","70–100 kcal","7–10"],

["Bulldog Inglês",18,25,"18–25 kg","Médio","60–85 kcal","6–8"],

["Basset Hound",20,29,"20–29 kg","Médio","65–90 kcal","6–9"],

["Bloodhound",36,50,"36–50 kg","Grande","90–120 kcal","9–12"],

["Weimaraner",25,40,"25–40 kg","Grande","80–110 kcal","8–11"],

["Vizsla",18,30,"18–30 kg","Médio","65–90 kcal","6–9"],

["Setter Irlandês",24,32,"24–32 kg","Grande","75–100 kcal","7–10"],

["Pointer Inglês",20,34,"20–34 kg","Grande","70–100 kcal","7–10"],

["Collie",18,30,"18–30 kg","Médio/Grande","65–90 kcal","6–9"],

["Pastor Australiano",18,29,"18–29 kg","Médio","65–90 kcal","6–9"],

["Pastor de Shetland",6,12,"6–12 kg","Pequeno/Médio","40–70 kcal","4–7"],

["Samoieda",16,30,"16–30 kg","Médio/Grande","65–90 kcal","6–9"],

["Malamute do Alasca",32,43,"32–43 kg","Grande","85–110 kcal","8–11"],

["Terra Nova",45,70,"45–70 kg","Gigante","100–140 kcal","10–14"],

["Leonberger",40,75,"40–75 kg","Gigante","90–140 kcal","9–14"],

["Mastiff",55,100,"55–100 kg","Gigante","110–150 kcal","11–15"],

["Mastim Napolitano",50,70,"50–70 kg","Gigante","100–140 kcal","10–14"],

["Whippet",9,14,"9–14 kg","Médio","50–70 kcal","5–7"],

["Galgo Inglês",25,40,"25–40 kg","Grande","70–100 kcal","7–10"],

["Basenji",9,11,"9–11 kg","Pequeno/Médio","45–60 kcal","4–6"],

["Cão de Água Português",16,27,"16–27 kg","Médio","60–90 kcal","6–9"],

["Australian Cattle Dog",15,22,"15–22 kg","Médio","60–85 kcal","6–8"],

["Dogue de Bordeaux",45,65,"45–65 kg","Gigante","100–140 kcal","10–14"],

["Airedale Terrier",18,29,"18–29 kg","Médio","65–90 kcal","6–9"],

["Fox Terrier",6,9,"6–9 kg","Pequeno","40–55 kcal","4–5"],

["Schnauzer Gigante",25,48,"25–48 kg","Grande","80–110 kcal","8–11"],

["Poodle Standard",20,32,"20–32 kg","Grande","70–100 kcal","7–10"]

];



/* =========================
   PRODUTOS
========================= */

const produtos=[

["Biscoito Natural","Biscoitos crocantes para cães.","9.90"],

["Bifinho Tradicional","Petisco macio para treinamento.","12.90"],

["Palito Dental","Auxilia na higiene bucal.","15.90"],

["Cookie de Frango","Cookie sabor frango.","14.90"],

["Snack de Carne","Petisco sabor carne.","11.90"],

["Biscoito Integral","Opção com ingredientes integrais.","13.90"],

["Ossinho Mastigável","Petisco para entretenimento.","17.90"],

["Snack de Vegetais","Petisco com sabor de vegetais.","12.50"]

];


const criadores=[
"Sophia",
"Maria Julia",
"Mariana",
"Anny",
"Duarte"
];


let pontos=
Number(localStorage.getItem("nutripet_pontos"))||0;

let carrinho=[];



/* =========================
   ABAS
========================= */

function aba(id,btn){

document
.querySelectorAll(".aba")
.forEach(x=>x.classList.remove("active"));

document
.querySelectorAll(".tab")
.forEach(x=>x.classList.remove("active"));

document
.getElementById(id)
.classList.add("active");

btn.classList.add("active");

}



/* =========================
   PESQUISA
========================= */

function normalizar(x){

return x
.normalize("NFD")
.replace(/[\u0300-\u036f]/g,"")
.toLowerCase();

}


function filtrar(){

let q=
normalizar(
document.getElementById("pesquisa").value
);

let p=
document.getElementById("porte").value;

render(

racas.filter(r=>

normalizar(r[0]).includes(q)&&

(p=="todos"||r[4]==p)

)

);

}



/* =========================
   MOSTRAR RAÇAS
========================= */

function render(lista){

let el=
document.getElementById("lista");

el.innerHTML="";

document.getElementById("contador")
.textContent=
lista.length+" raças";


if(!lista.length){

el.innerHTML=
'<div class="empty">Nenhuma raça encontrada.</div>';

return;

}


lista.forEach(r=>{

let c=
document.createElement("div");

c.className="card";

let i=
r[0]
.split(" ")
.slice(0,2)
.map(x=>x[0])
.join("")
.toUpperCase();


c.innerHTML=`

<div class="top">

<div class="icon">
${i}
</div>

<span class="tag">
${r[4]}
</span>

</div>

<h3>
${r[0]}
</h3>

<p>
Informações sobre peso e alimentação.
</p>

<span class="weight">
Peso: ${r[3]}
</span>

`;


c.onclick=
()=>abrir(r);

el.appendChild(c);

});

}



/* =========================
   MODAL
========================= */

function abrir(r){

document.getElementById("mNome")
.textContent=r[0];

document.getElementById("mDesc")
.textContent=
"Informações gerais sobre a raça.";

document.getElementById("mPeso")
.textContent=r[3];

document.getElementById("mPorte")
.textContent=r[4];

document.getElementById("mCal")
.textContent=r[5];

document.getElementById("mPet")
.textContent=r[6];

document.getElementById("peso").value="";

document.getElementById("resultado")
.style.display="none";

document.getElementById("modal")
.classList.add("show");

}


function fechar(e){

if(
!e ||
e.target==
document.getElementById("modal")
)

document
.getElementById("modal")
.classList.remove("show");

}



/* =========================
   CALCULAR PETISCOS
========================= */

function calcular(){

let p=
parseFloat(
document.getElementById("peso").value
);


if(!p||p<=0){

alert("Digite um peso válido.");

return;

}


let kcal=
Math.round(p*5);

let pet=
Math.max(
1,
Math.round(kcal/10)
);


let r=
document.getElementById("resultado");


r.innerHTML=`

Para ${p.toFixed(1)} kg:

aproximadamente

<strong>
${kcal} kcal
</strong>,

equivalente a cerca de

<strong>
${pet} petisco${pet!=1?"s":""}
</strong>

de 10 kcal.

`;

r.style.display="block";

}



/* =========================
   PRODUTOS
========================= */

function renderProdutos(){

document.getElementById("produtos")
.innerHTML=

produtos.map((p,i)=>`

<div class="product">

<div class="product-icon">
PET
</div>

<h3>
${p[0]}
</h3>

<p>
${p[1]}
</p>

<div class="price">
R$ ${p[2].replace(".",",")}
</div>

<div class="buy">

<input
type="number"
id="q${i}"
min="1"
value="1"
>

<button
class="btn"
onclick="adicionar(${i})">

Adicionar

</button>

</div>

</div>

`).join("");

}



/* =========================
   CARRINHO
========================= */

function adicionar(i){

let q=
Number(
document.getElementById("q"+i).value
)||1;


let x=
carrinho.find(a=>a.i==i);


if(x)

x.q+=q;

else

carrinho.push({
i,
q
});


renderCarrinho();

}


function renderCarrinho(){

let e=
document.getElementById("carrinho");


if(!carrinho.length){

e.innerHTML=
'<p style="color:#777;font-size:13px">Seu carrinho está vazio.</p>';

document.getElementById("total")
.textContent="0,00";

return;

}


let t=0;


e.innerHTML=

carrinho.map(x=>{

let p=
produtos[x.i];

let v=
Number(p[2])*x.q;

t+=v;


return`

<div class="cart-item">

<span>
${p[0]} × ${x.q}
</span>

<strong>
R$ ${v.toFixed(2).replace(".",",")}
</strong>

</div>

`;

}).join("");


document.getElementById("total")
.textContent=
t.toFixed(2).replace(".",",");

}



/* =========================
   LIMPAR CARRINHO
========================= */

function limparCarrinho(){

carrinho=[];

renderCarrinho();

}



/* =========================
   FINALIZAR COMPRA
========================= */

function finalizarCompra(){

if(!carrinho.length){

alert(
"Adicione algum produto ao carrinho."
);

return;

}


carrinho=[];

renderCarrinho();


if(pontos<10)

pontos++;


localStorage.setItem(
"nutripet_pontos",
pontos
);


criarPontos();


alert(
"Compra realizada! Você ganhou 1 ponto."
);

}



/* =========================
   FIDELIDADE
========================= */

function resetPontos(){

if(
confirm(
"Deseja realmente resetar seu cartão fidelidade?"
)
){

pontos=0;

localStorage.setItem(
"nutripet_pontos",
0
);

criarPontos();

}

}


function criarPontos(){

let e=
document.getElementById("pontos");

e.innerHTML="";


for(let i=1;i<=10;i++){

let p=
document.createElement("div");

p.className=
"point"+
(i<=pontos?" marked":"");

p.textContent=
i<=pontos?"✓":i;

e.appendChild(p);

}


document.getElementById("nPontos")
.textContent=pontos;


document.getElementById("premio")
.style.display=
pontos>=10?"block":"none";

}



/* =========================
   CRIADORES
========================= */

document.getElementById("criadoresLista")
.innerHTML=

criadores
.map(x=>`

<div class="person">
${x}
</div>

`)
.join("");



/* =========================
   INICIALIZAÇÃO
========================= */

render(racas);

renderProdutos();

renderCarrinho();

criarPontos();


document.addEventListener(
"keydown",
e=>{

if(e.key=="Escape")

fechar();

}
);

</script>

</body>
</html>
</script></body></html>
